{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tensorfoundry.dev/schemas/specialist_model_unit.v0.json",
  "title": "TensorFoundry Specialist Model Unit v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "domain",
    "model",
    "eval_pack",
    "lineage",
    "hardware_profile",
    "failure_modes",
    "license",
    "usage_constraints",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "specialist_model_unit.v0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "domain": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "size",
        "format"
      ],
      "properties": {
        "family": {
          "type": "string"
        },
        "size": {
          "type": "string"
        },
        "format": {
          "type": "string",
          "enum": [
            "safetensors",
            "gguf",
            "onnx",
            "other"
          ]
        },
        "base_model": {
          "type": "string"
        },
        "quantization": {
          "type": "string"
        }
      }
    },
    "eval_pack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suite_id",
        "report_path",
        "score"
      ],
      "properties": {
        "suite_id": {
          "type": "string"
        },
        "report_path": {
          "type": "string"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reliability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "latency_ms_p50": {
          "type": "number",
          "minimum": 0
        },
        "cost_per_success_usd": {
          "type": "number",
          "minimum": 0
        },
        "benchmark_run_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "distillation_eval_path": {
          "type": "string"
        },
        "benchmark_matrix_path": {
          "type": "string"
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_sources",
        "dataset_sources",
        "distillation_recipe"
      ],
      "properties": {
        "trace_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "dataset_sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "distillation_recipe": {
          "type": "string"
        },
        "otel_trace_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mcp_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "training_preflight": {
          "type": "string"
        },
        "dataset_hashes": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "split_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "hardware_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "ram_gb",
        "latency_ms_p50"
      ],
      "properties": {
        "target": {
          "type": "string",
          "enum": [
            "cpu",
            "gpu",
            "edge",
            "mixed"
          ]
        },
        "ram_gb": {
          "type": "number",
          "minimum": 0
        },
        "vram_gb": {
          "type": "number",
          "minimum": 0
        },
        "latency_ms_p50": {
          "type": "number",
          "minimum": 0
        },
        "latency_ms_p95": {
          "type": "number",
          "minimum": 0
        },
        "throughput_tokens_per_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "mitigation"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "mitigation": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_license",
        "dataset_license"
      ],
      "properties": {
        "model_license": {
          "type": "string"
        },
        "dataset_license": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "usage_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapters",
        "safetensors",
        "gguf",
        "ollama"
      ],
      "properties": {
        "adapters": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "safetensors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gguf": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ollama": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "modelfile",
            "tag"
          ],
          "properties": {
            "modelfile": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        },
        "checksums": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
