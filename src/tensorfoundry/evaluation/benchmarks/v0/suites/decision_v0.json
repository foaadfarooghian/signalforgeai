{
  "suite_name": "benchmark_v0_decision",
  "agent": "decision_agent",
  "cases": [
    {
      "id": "dec_v0_001",
      "task": "Choose what TensorFoundry should build next after Benchmark v0.",
      "inputs": {
        "constraints": [
          "Keep it OSS-first",
          "Hardware not ready for training"
        ],
        "options": [
          "Expand benchmark tasks",
          "Add learning-from-logs converters",
          "Build a UI dashboard"
        ]
      },
      "expect": { "status": "success", "contains_any": ["benchmark", "learning", "logs", "dashboard"] }
    },
    {
      "id": "dec_v0_002",
      "task": "Decide how to manage breaking changes in the logging schema.",
      "inputs": {
        "constraints": ["Avoid breaking users", "Prefer additive changes"],
        "options": [
          "Introduce schema versioning",
          "Allow breaking changes freely",
          "Freeze schema permanently"
        ]
      },
      "expect": { "status": "success", "contains_any": ["version", "additive", "compat", "schema"] }
    },
    {
      "id": "dec_v0_003",
      "task": "Pick a branch strategy for an OSS project with dev/exp/prod.",
      "inputs": {
        "constraints": ["Keep prod stable", "Support experimentation"],
        "options": [
          "Protect prod + merge from dev",
          "Work directly on prod",
          "Only use one branch"
        ]
      },
      "expect": { "status": "success", "contains_any": ["prod", "dev", "protect", "merge"] }
    },
    {
      "id": "dec_v0_004",
      "task": "Choose the next quality gate to add after CI + tests.",
      "inputs": {
        "constraints": ["Keep CI fast", "Prefer high signal checks"],
        "options": [
          "Add ruff formatting + lint",
          "Add a full integration test matrix",
          "Remove type checking"
        ]
      },
      "expect": { "status": "success", "contains_any": ["ruff", "lint", "type", "mypy"] }
    }
  ]
}